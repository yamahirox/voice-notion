# コピーして .env にリネームし、値を埋めてください（.env は Git に含めません）
#
# Notion: https://www.notion.so/my-integrations でインテグレーション作成 → Secret をコピー
# 対象データベースをそのインテグレーションに「共有」しておくこと

NOTION_API_KEY=secret_ここにIntegration_Secret
NOTION_DB_6PON_ID=DB6本タスク管理のデータベースID
NOTION_DATABASE_ID=32文字のデータベースID（ハイフンなしでも可）

# NotebookLM 風「ソースは別の Notion DB」用（タスク登録用 NOTION_DATABASE_ID とは別IDを推奨）
# 同じインテグレーションで、その KB データベースにも「接続」を付与してください。
NOTION_KB_DATABASE_ID=ナレッジ用データベースID

# OpenAI API（埋め込み + チャット）。https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# 任意: 既定 gpt-4o-mini / text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# 互換 API 向け（例: Azure 等は別途ドキュメント参照）
# OPENAI_BASE_URL=https://api.openai.com/v1
# KB 同期キャッシュ秒（既定 300。0=毎回フル再構築）
# NOTION_KB_CACHE_SEC=300
# 取得する DB 行の上限（既定 400）
# NOTION_KB_MAX_PAGES=400
# 回答に使う近傍チャンク数（既定 8）
# NOTION_KB_TOP_K=8

# Gmail 連携（--from-gmail 使うときのみ）
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=アプリパスワード

# 公開デプロイ時（推奨）: 知らない人に Notion に書かれないよう長いランダム文字列を設定する。
# スマホ画面の「接続用パスワード」に同じ値を保存する。
# VOICE_SHARED_SECRET=

# クラウド（Render / Railway）ではホストが PORT を渡す。手元で公開モードを試すときだけ 1
# VOICE_CLOUD=1

# フロントだけ別オリジンに置くときなど必要なら 1
# VOICE_CORS_ALLOW_ALL=1
